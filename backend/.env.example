# ManakSetu Environment Configuration Template

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Google Gemini API Key (for ManakBot RAG engine)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# PostgreSQL Database (Optional - falls back to SQLite automatically if omitted)
# Example: postgresql://user:password@localhost:5432/manaksetu
DATABASE_URL=

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=*
